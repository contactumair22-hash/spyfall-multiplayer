# Local dev: leave blank; Vite proxies Socket.IO to localhost:3001.
# Production frontend: set this to your deployed backend URL, e.g. https://your-game-server.onrender.com
VITE_SERVER_URL=
# Backend server port (hosting providers usually set PORT automatically)
PORT=3001
# Production backend: set this to your frontend URL, e.g. https://your-game.vercel.app
CLIENT_ORIGIN=*